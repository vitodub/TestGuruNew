<h1>Create a question for <%= @test.title %></h1>

<form action="/tests/<%= params[:test_id] %>/questions" method="post">
  <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden">

  <p>
    <label for="question-body">Body:</label>
    <input type="text" id="question-body" name="question[body]">
  <p><br>

  <input type="submit" value="Create">
</form>
